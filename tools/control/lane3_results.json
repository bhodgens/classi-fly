{
  "lane": "3 - temporal/rhythmic tasks on the Arena substrate",
  "repo": "/Users/caimlas/git/classi-fly",
  "tasks": {
    "rhythm": {
      "definition": "Arena mode='blink', period P. Pulse = thrust>0.5 emitted at step t with (t+1)%P==0 (immediately before each light onset).",
      "success_criterion": "hit_rate >= 0.8 AND false_pulses_per_100_steps <= 2.0",
      "pulse_threshold": 0.5,
      "periods": [
        3,
        8
      ]
    },
    "anomaly": {
      "definition": "Arena mode='blink' with period P; at a hidden switch step in the last third of the episode the period doubles to 2P. Flag = thrust < -0.5 within 16 steps after the switch.",
      "switch_rule": "seed-dependent, in [133, 200) via rng(seed*7919+period); deterministic",
      "metrics": "detection latency (steps from switch to first flag), false-alarm rate per 100 steps before the switch",
      "train_window_note": "training target window 24 steps (3x P3 gap), eval scoring window 16 steps; targets teach the period-change mapping, scoring rewards fast detection"
    }
  },
  "protocol": {
    "eval": "run_many_factory-equivalent, 200 episodes, seeds 1000-1199, fresh stateful controller per episode",
    "heads": [
      "larval_reservoir (real connectome, lane-1-standard build)",
      "synthetic_2048 (generate(seed=42,n=2048,fan_in=8,inhib_frac=0.2))",
      "memoryless_linear (ridge on the raw 7 sensors, same fit)",
      "memory_heuristic (rhythm task only)",
      "constant-thrust floors/ceilings"
    ],
    "training": "two-stage ridge: states from randomized-policy episodes (seeds 20000+, policies seeded 30000+, disjoint from eval), arctanh targets, lambda in [1,3,10,30,100,300,1000] swept on held-out validation, refit on train+val; tanh output squash",
    "train_episodes": 120,
    "determinism": "all seeds fixed"
  },
